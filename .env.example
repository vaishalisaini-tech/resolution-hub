INSTANCE_CONFIG=config/instance.json
DATABASE_PATH=data/hub-v3.db
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
COOKIE_SECURE=false
CHAT_PROVIDER=evidence
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
ALLOW_EXTERNAL_AI=false
AI_ALLOWED_HOSTS=
VISION_ENABLED=false
AI_EXTRACT_ENABLED=false
UPLOAD_SCAN=off
CLAMSCAN_PATH=clamscan
OCR_ENABLED=false
# Email-based password reset. Leave SMTP_HOST empty to log reset links instead of sending mail.
APP_BASE_URL=http://127.0.0.1:8001
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=
